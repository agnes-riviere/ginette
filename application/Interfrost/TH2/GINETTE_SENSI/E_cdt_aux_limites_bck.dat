valclc_droite=00000000d+00     									c Bord droit	 ; d9.0 C TRANSPORT
iclc_haut=-1               										c Surface ; i2	C TRANSPORT
valclc_haut=00000000d+00     									c Surface  ; d9.0 	C TRANSPORT
iclc_bas=-1               										c Base ; i2		C TRANSPORT
valclc_bas=00000000d+00     									c Base   ; d9.0	C TRANSPORT
iclt_gauche=-2               gauche : temperature imposee Tin ; i2	C THERMIQUE
valclt_gauche=5.00000E+00      Tin = +5 C ; d12.0	C THERMIQUE
iclt_droite=-1               droite : flux conductif nul (sortie par advection seule) ; i2	C THERMIQUE
valclt_droite=00000000d+00     d12.0	C THERMIQUE
iclt_haut=-1               haut : flux nul (plan de symetrie) ; i2	C THERMIQUE
valclt_haut=00000000d+00     d12.0	C THERMIQUE
iclt_bas=-1               bas : flux conductif nul (TH2) ; i2	C THERMIQUE
valclt_bas=00000000d+00     d12.0	C THERMIQUE
