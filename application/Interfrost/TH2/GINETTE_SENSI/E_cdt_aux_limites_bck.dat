icl_gauche=[icl_lr]         icl=-1 flux impose sur une face, icl=-2 charge imposee (m) ; bord gauche = amont ; i2	C ECOULEMENT
valcl_gauche=[h_left]         charge amont H0+dH (m) = gradient*Lx ; d12.0	C ECOULEMENT
icl_droite=[icl_lr]         bord droit = aval ; i2	C ECOULEMENT
valcl_droite=00000000d+00     charge aval H0 = 0 ; d12.0	C ECOULEMENT
icl_haut=-1               haut : flux nul (plan de symetrie) ; i2	C ECOULEMENT
valcl_haut=00000000d+00     d12.0	C ECOULEMENT
icl_bas=-1               bas : flux nul ; i2	C ECOULEMENT
valcl_bas=00000000d+00     d12.0	C ECOULEMENT
