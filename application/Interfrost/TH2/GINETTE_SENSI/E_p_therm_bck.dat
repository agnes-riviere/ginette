cpm=0835D+00         m2/s2/C	capacite calorifique specifique du solide (fiche : 835)
ymoycondtherm=ARITH            LUNAR,WOODS,GEOME,ARITH,NEUMA - ARITH : lambda_eq = eps*(Sw*lw + Si*li) + (1-eps)*ls, comme la fiche InterFrost
icycle=1                	       icycle=1 gel/degel actif, icycle=0 transport de chaleur sans gel/degel	####### GEL/DEGEL
igel=2                 indice gel=1 premiere iteration en gel igel=2 premiere iteration en degel (force a 2 par ytest=TH1) ####### GEL/DEGE
igelzns=0                	        igelzns=1 gel zone non saturee				 ####### GEL/DEGE
iomdegel=0              zone non gelee nappe libre                              ####### GEL/DEGE
ytypakrice=MCKEN            Fully saturated : LINET,LINES,IMPED,MCKEN,ANNUL,UDEF - MCKEN : kr = max(10^(-omega*Si), dk), fiche InterFrost (McKenzie et al. 2007)
ytypsice=EXPON            EXPON,LINEA,UDEF - EXPON : Sw = Sres + (1-Sres)*exp(-(T/W)^2), W = cimp (fiche InterFrost)
